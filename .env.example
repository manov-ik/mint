# Mint Configuration Template

# Database Connection (Standard PostgreSQL URL)
DATABASE_URL="postgresql://mint_user:mint_password@localhost:5432/mint_db"

# NextAuth Config (Required for encryption and sessions)
# Generate a secure key using: openssl rand -hex 32
NEXTAUTH_SECRET="your-nextauth-secret-key"
NEXTAUTH_URL="http://localhost:3000"


# API Endpoints
# NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# (Optional) Discord Webhook for bug reporting and feedback
DISCORD_WEBHOOK_URL=""

# (Optional) Disable automatic database migrations on container startup by setting to "true"
DISABLE_AUTO_MIGRATE="false"
